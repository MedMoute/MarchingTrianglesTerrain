<Project Sdk="Godot.NET.Sdk/4.6.2" InitialTargets="CreateSymlinks">

    <!--- SOURCE for symlink idea: https://github.com/godot-gdunit-labs/gdUnit4NetExamples/blob/master/Examples/Advanced/Setup/MultiProjectSetup/ExampleProject.Test/ExampleProject.Test.csproj -->

    <PropertyGroup>
        <!-- Disable Central Package Management for Godot projects -->
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
        <TargetFramework>net9.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>MarchingTrianglesTerrain.demo</RootNamespace>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <!-- Ensures all dependencies are copied to output for test execution -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <!-- NO ProjectReference - we compile from symlinked source instead -->
        <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2"/>
        <PackageReference Include="MathNet.Spatial" Version="0.6.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    </ItemGroup>


    <!--
        ============================================================
        SYMBOLIC LINK CREATION (Runs before MSBuild evaluation)
        ============================================================
    -->
    <Target Name="CreateSymlinks">
        <PropertyGroup>
            <!-- Define source and target paths for both symlinks -->
            <SrcSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Plugin/src/addons'))</SrcSource>
            <SrcTarget>$(MSBuildProjectDirectory)/addons</SrcTarget>
        </PropertyGroup>

        <!-- Windows: Create symlinks -->
        <Exec Command="if not exist &quot;$(SrcTarget)&quot; mklink /D &quot;$(SrcTarget)&quot; &quot;$(SrcSource)&quot;"
              Condition="'$(OS)' == 'Windows_NT'"
              ContinueOnError="true"/>

        <!-- Unix/Linux/Mac: Create symlinks -->
        <Exec Command="[ ! -L '$(SrcTarget)' ] &amp;&amp; ln -s '$(SrcSource)' '$(SrcTarget)' || true"
              Condition="'$(OS)' != 'Windows_NT'"
              ContinueOnError="true"/>

        <!-- Verify symlink exists and is accessible -->
        <Error Condition="!Exists('$(SrcTarget)')"
               Text="Failed to create symlink at $(SrcTarget). On Windows, try running as Administrator or enabling Developer Mode."/>

        <!-- Log confirmation -->
        <Message Text="✓ Symlink verified: $(SrcTarget) -> $(SrcSource)" Importance="high"/>
    </Target>
</Project>